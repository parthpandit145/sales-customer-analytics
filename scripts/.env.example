# Copy to scripts/.env and fill in. scripts/.env is gitignored -- never commit it.
#
# Neon gives you this string under Dashboard -> Connect -> Connection string.
# Use the POOLED endpoint (the host containing "-pooler") for n8n and Power BI,
# and the DIRECT endpoint for the bulk load below -- COPY through a pooler is
# slower and more likely to time out.
#
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Where the Olist CSVs live once downloaded
DATA_DIR="./data"
