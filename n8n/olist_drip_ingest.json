{
  "name": "Olist Drip Ingest",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Every 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -660,
        300
      ]
    },
    {
      "parameters": {},
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Run Once (Manual)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -660,
        480
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c1",
              "name": "batch_size",
              "value": 500,
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -440,
        380
      ],
      "notes": "Batch size is the one knob. 500 orders/15min drains the 99k-order feed in about 2 days of wall clock, which is what makes the 'live pipeline' story real rather than a one-shot bulk load."
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM ops.ingest_next_batch($1);",
        "options": {
          "queryReplacement": "={{ $json.batch_size }}"
        }
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Ingest Batch",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        -220,
        380
      ],
      "alwaysOutputData": true,
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Neon - Olist"
        }
      },
      "notes": "Watermark-driven and idempotent, so the retry above is safe: a retried batch re-reads the same window and every insert is ON CONFLICT DO NOTHING."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-1",
              "leftValue": "={{ $json.orders_attempted }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "New Orders?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        20,
        380
      ]
    },
    {
      "parameters": {},
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Feed Drained",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        260,
        540
      ],
      "notes": "Source exhausted. Nothing to refresh, nothing to alert on."
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM ops.post_batch_maintenance();",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "Refresh Statistics",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        260,
        260
      ],
      "onError": "continueErrorOutput",
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Neon - Olist"
        }
      },
      "notes": "ANALYZE on the landing tables. raw.* grows 1000 rows at a time and stale planner statistics are what turn a fast index scan into a full table scan."
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM ops.run_dq_checks($1);",
        "options": {
          "queryReplacement": "={{ $('Ingest Batch').first().json.batch_id }}"
        }
      },
      "id": "a1000000-0000-4000-8000-000000000008",
      "name": "Data Quality Checks",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        500,
        260
      ],
      "onError": "continueErrorOutput",
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Neon - Olist"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "f-1",
              "leftValue": "={{ $json.severity }}",
              "rightValue": "error",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "f-2",
              "leftValue": "={{ $json.status }}",
              "rightValue": "fail",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000009",
      "name": "Keep Only Hard Failures",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        740,
        260
      ],
      "alwaysOutputData": true,
      "notes": "warn-severity checks are recorded in ops.dq_result but do not stop the pipeline. Only error-severity failures do."
    },
    {
      "parameters": {
        "errorMessage": "=Data quality failure after batch {{ $('Ingest Batch').first().json.batch_id }}: {{ $json.check_name }} observed {{ $json.observed }} against threshold {{ $json.threshold }} ({{ $json.detail }})"
      },
      "id": "a1000000-0000-4000-8000-00000000000a",
      "name": "Fail The Run",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        980,
        260
      ],
      "notes": "A silent bad refresh is worse than a red execution. Fail loudly."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "e1",
              "name": "source_table",
              "value": "=n8n:{{ $json.error?.node?.name || 'unknown_node' }}",
              "type": "string"
            },
            {
              "id": "e2",
              "name": "record_key",
              "value": "={{ $execution.id }}",
              "type": "string"
            },
            {
              "id": "e3",
              "name": "error_type",
              "value": "pipeline_failure",
              "type": "string"
            },
            {
              "id": "e4",
              "name": "error_detail",
              "value": "={{ ($json.error?.message || JSON.stringify($json)).toString().slice(0, 2000) }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-00000000000b",
      "name": "Shape Error",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        260,
        720
      ]
    },
    {
      "parameters": {
        "schema": {
          "__rl": true,
          "value": "ops",
          "mode": "name"
        },
        "table": {
          "__rl": true,
          "value": "load_errors",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": []
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-00000000000c",
      "name": "Log To ops.load_errors",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        500,
        720
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Neon - Olist"
        }
      },
      "notes": "Every branch that can fail lands here. ops.load_errors is the single place to look when the dashboard looks wrong."
    }
  ],
  "connections": {
    "Every 15 Minutes": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Once (Manual)": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Ingest Batch",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ingest Batch": {
      "main": [
        [
          {
            "node": "New Orders?",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Shape Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "New Orders?": {
      "main": [
        [
          {
            "node": "Refresh Statistics",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Feed Drained",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Refresh Marts": {
      "main": [
        [
          {
            "node": "Data Quality Checks",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Shape Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Data Quality Checks": {
      "main": [
        [
          {
            "node": "Keep Only Hard Failures",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Shape Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Keep Only Hard Failures": {
      "main": [
        [
          {
            "node": "Fail The Run",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Shape Error": {
      "main": [
        [
          {
            "node": "Log To ops.load_errors",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all"
  },
  "pinData": {},
  "meta": {
    "instanceId": "olist-sales-customer-analytics"
  },
  "tags": []
}
